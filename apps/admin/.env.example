# ==============================================================================
# StandUp INDO Timika - apps/admin (.env.example)
# Configuration template for Vercel Project 2 (Admin Operations Center)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Direct / Unpooled connection string (Digunakan untuk migrasi / dev lokal)
DATABASE_URL="postgresql://neondb_owner:<PASSWORD>@ep-<ENDPOINT_ID>.<REGION>.aws.neon.tech/neondb?sslmode=require"

# DATABASE_URL_POOLED: Connection Pooler URL (Wajib di Vercel Serverless Functions)
# Dapatkan dari Neon Dashboard -> Connection Details -> centang 'Connection pooling' (host berakhiran -pooler)
DATABASE_URL_POOLED="postgresql://neondb_owner:<PASSWORD>@ep-<ENDPOINT_ID>-pooler.<REGION>.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. CLOUDINARY CREDENTIALS (Admin Upload & Media Management)
# ------------------------------------------------------------------------------
# Ambil dari Cloudinary Console -> Dashboard -> API Keys & Product Environment
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Mode Storage: 'cloudinary' untuk production
STORAGE_PROVIDER="cloudinary"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key untuk menandatangani session / token hash (generate acak min. 32 karakter)
# Contoh generate: openssl rand -base64 32
AUTH_SECRET="your-super-secret-key-min-32-chars-random-string"
JWT_SECRET="your-super-secret-key-min-32-chars-random-string"

# ------------------------------------------------------------------------------
# 4. APPLICATION URLS & CROSS-DOMAIN NAVIGATION
# ------------------------------------------------------------------------------
# URL domain produksi publik aplikasi Web (contoh: https://standuptimika.com)
NEXT_PUBLIC_WEB_URL="http://localhost:5000"

# URL domain produksi dashboard Admin (contoh: https://admin.standuptimika.com)
NEXT_PUBLIC_ADMIN_URL="http://localhost:5001"
NEXT_PUBLIC_APP_URL="http://localhost:5001"
