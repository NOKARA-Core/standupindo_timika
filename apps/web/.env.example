# ==============================================================================
# StandUp INDO Timika - apps/web (.env.example)
# Configuration template for Vercel Project 1 (Public Web Landing Page)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Direct / Unpooled connection string (Digunakan untuk migrasi / dev lokal)
DATABASE_URL="postgresql://neondb_owner:<PASSWORD>@ep-<ENDPOINT_ID>.<REGION>.aws.neon.tech/neondb?sslmode=require"

# DATABASE_URL_POOLED: Connection Pooler URL (Wajib di Vercel Serverless Functions)
# Dapatkan dari Neon Dashboard -> Connection Details -> centang 'Connection pooling' (host berakhiran -pooler)
DATABASE_URL_POOLED="postgresql://neondb_owner:<PASSWORD>@ep-<ENDPOINT_ID>-pooler.<REGION>.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. CLOUDINARY CDN (Public Asset Delivery)
# ------------------------------------------------------------------------------
# Cloud Name publik untuk memuat flyer acara, headshot komika, dan galeri
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"

# ------------------------------------------------------------------------------
# 3. APPLICATION URLS & CROSS-DOMAIN NAVIGATION
# ------------------------------------------------------------------------------
# URL domain produksi publik aplikasi Web (contoh: https://standuptimika.com)
NEXT_PUBLIC_SITE_URL="http://localhost:5000"

# URL domain dashboard admin untuk navigasi tombol portal admin
NEXT_PUBLIC_ADMIN_URL="http://localhost:5001"
